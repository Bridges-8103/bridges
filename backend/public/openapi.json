          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 400
                },
                "data": {
                  "type": "null",
                  "nullable": true,
                  "example": null
                },
                "message": {
                  "type": "string",
                  "example": "Resource already exists"
                },
                "errors": {
                  "type": "string",
                  "example": "409"
                }
              },
              "required": [
                "status",
                "data",
                "message"
              ]
            }
          }
        }
      },
      "500": {
