          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 400
                },
                "data": {
                  "type": "null",
                  "nullable": true,
                  "example": null
                },
                "message": {
                  "type": "string",
                  "example": "An unexpected internal server error occurred"
                },
                "errors": {
                  "type": "string",
                  "example": "500"
                }
              },
              "required": [
                "status",
                "data",
                "message"
              ]
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/me": {
      "get": {
        "operationId": "get-auth-me",
        "summary": "Current user session",
        "description": "Returns the claims of the currently authenticated user.",
        "tags": [
          "Auth"
        ],
        "parameters": [],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMeResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
