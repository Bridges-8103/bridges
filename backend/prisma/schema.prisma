datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 Int                @id @default(autoincrement())
  name               String
  email              String             @unique
  role               Role               @default(STUDENT)
  isSuspended        Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)

  bio                String?
  avatarUrl          String?
  phoneNumber        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Role-specific information
  studentDetail StudentDetail?
  mentorDetail  MentorDetail?

  reportsReceived Report[] @relation("ReportedUser")

  // Mentorship session slots and bookings
  mentorSlots     SessionSlot[]    @relation("MentorSlots")
  mentorBookings  SessionBooking[] @relation("MentorBookings")
  studentBookings SessionBooking[] @relation("StudentBookings")

  // Push notification device tokens
  pushTokens      PushToken[]      @relation("UserPushTokens")

  @@index([role])
  @@index([verificationStatus])
}

// ==========================================
// STUDENT-SPECIFIC INFORMATION
// ==========================================

model StudentDetail {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  university   String?
  degree       String?
  fieldOfStudy String?
  yearOfStudy  Int?

  interests   String[]
  skills      String[]
  careerGoals String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([university])
  @@index([fieldOfStudy])
}

// ==========================================
// MENTOR-SPECIFIC INFORMATION
// ==========================================

model MentorDetail {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobTitle        String?
  company         String?
  industry        String?
  yearsExperience Int?

  expertise          String[]
  preferredEnquiries String[]

  linkedinUrl String?
  contactEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([industry])
}

// ==========================================
// REPORT
// ==========================================

model Report {
  id             Int @id @default(autoincrement())
  reporterId     Int
  reportedUserId Int

  reason String
  status String @default("OPEN")

  createdAt DateTime @default(now())

  reportedUser User @relation("ReportedUser", fields: [reportedUserId], references: [id])

  @@index([reportedUserId])
  @@index([reporterId])
  @@index([status])
}

// ==========================================
// TAXONOMY (CATEGORIES & TAGS)
// ==========================================

enum TagType {
  INTEREST
  SKILL
  BOTH
}

model Category {
  id          Int           @id @default(autoincrement())
  slug        String        @unique
  name        String
  icon        String
  sortOrder   Int           @default(0)
  mentorCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tags        TaxonomyTag[]

  @@index([slug])
}

model TaxonomyTag {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  name        String
  type        TagType   @default(BOTH)
  isCurated   Boolean   @default(false)
  mentorCount Int       @default(0)
  aliases     String[]  @default([])

  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
  @@index([type])
  @@index([mentorCount])
  @@index([isCurated])
}

// ==========================================
// MENTORSHIP SESSIONS & AVAILABILITY
// ==========================================

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

model SessionSlot {
  id          Int      @id @default(autoincrement())
  mentorId    Int
  startTime   DateTime
  endTime     DateTime
  isAvailable Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mentor      User            @relation("MentorSlots", fields: [mentorId], references: [id], onDelete: Cascade)
  booking     SessionBooking?

  @@unique([mentorId, startTime])
  @@index([mentorId, startTime])
  @@index([isAvailable])
}

model SessionBooking {
  id            Int           @id @default(autoincrement())
  slotId        Int           @unique
  mentorId      Int
  studentId     Int
  batchId       String?
  topic         String
  notes         String?
  status        BookingStatus @default(PENDING)
  meetingLink   String?
  declineReason String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  slot          SessionSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  mentor        User          @relation("MentorBookings", fields: [mentorId], references: [id], onDelete: Cascade)
  student       User          @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([mentorId, status])
  @@index([studentId, status])
  @@index([batchId])
}

// ==========================================
// PUSH NOTIFICATIONS
// ==========================================

model PushToken {
  id         Int       @id @default(autoincrement())
  userId     Int?
  token      String    @unique
  platform   String?   // "ios" | "android" | "web"
  deviceId   String?
  deviceName String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  user       User?     @relation("UserPushTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([isActive])
}
