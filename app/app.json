{
  "expo": {
    "name": "Bridges",
    "slug": "bridges",
    "owner": "megatunger",
    "version": "1.0.50",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app",
    "userInterfaceStyle": "light",
    "extra": {
      "eas": {
        "projectId": "11bc69db-f44f-4611-a65a-d13aece96343"
      }
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.bridges8103.app",
      "buildNumber": "51",
      "appleTeamId": "JR22X95AFT"
    },
    "android": {
      "package": "com.bridges.app",
      "versionCode": 51,
      "adaptiveIcon": {
        "backgroundColor": "#140C59",
        "foregroundImage": "./assets/images/splash-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#140C59",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 224
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#140C59",
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
