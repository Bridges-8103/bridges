{
  "expo": {
    "name": "Bridges",
    "slug": "app",
    "version": "1.0.23",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.bridges.app"
    },
    "android": {
      "package": "com.bridges.app",
      "versionCode": 24,
      "adaptiveIcon": {
        "backgroundColor": "#140C59",
        "foregroundImage": "./assets/images/splash-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#140C59",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 224
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
